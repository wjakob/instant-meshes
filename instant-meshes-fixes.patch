index e4878bc..6f3d850 100644
--- src/native_file_dialog.cpp
+++ src/native_file_dialog.cpp
@@ -48,4 +48,75 @@ std::string native_file_dialog(
     return result;
 }
 
+#elif defined(__linux__)
+
+#include <cstdio>
+#include <string>
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+
+std::string native_file_dialog(
+    const std::vector<std::pair<std::string, std::string>> &filetypes,
+    bool save)
+{
+    // Detect KDE Plasma desktop
+    bool isKDE = false;
+    const char* xdgDesktop = getenv("XDG_CURRENT_DESKTOP");
+    const char* kdeSession = getenv("KDE_FULL_SESSION");
+    const char* desktopSession = getenv("DESKTOP_SESSION");
+    if (xdgDesktop && (strstr(xdgDesktop, "KDE") || strstr(xdgDesktop, "kde")))
+        isKDE = true;
+    else if (kdeSession && strcmp(kdeSession, "true") == 0)
+        isKDE = true;
+    else if (desktopSession && (strstr(desktopSession, "kde") || strstr(desktopSession, "plasma")))
+        isKDE = true;
+
+    std::string cmd;
+    
+    if (isKDE) {
+        // Use kdialog on KDE Plasma
+        cmd = "kdialog ";
+        if (save)
+            cmd += "--getsavefilename ";
+        else
+            cmd += "--getopenfilename ";
+        cmd += "\"$HOME\" \"";
+        for (auto& pair : filetypes) {
+            cmd += "*." + pair.first + " ";
+        }
+        cmd += "\" --title \"";
+        cmd += save ? "Save Mesh" : "Open Mesh";
+        cmd += "\"";
+    } else {
+        // Fallback to zenity
+        cmd = "/usr/bin/zenity --file-selection ";
+        if (save)
+            cmd += "--save ";
+        cmd += "--file-filter=\"";
+        for (auto& pair : filetypes)
+            cmd += "\"*." + pair.first + "\" ";
+        cmd += "\"";
+    }
+
+    char buffer[4096];
+    std::string result;
+    FILE *pipe = popen(cmd.c_str(), "r");
+    if (!pipe)
+        return "";
+
+    while (fgets(buffer, sizeof(buffer), pipe) != nullptr)
+        result += buffer;
+
+    int status = pclose(pipe);
+    if (status != 0)
+        return "";
+
+    // Remove trailing newline
+    result.erase(std::remove(result.begin(), result.end(), '\n'), result.end());
+    result.erase(std::remove(result.begin(), result.end(), '\r'), result.end());
+
+    return result;
+}
+
 #endif
